{
  "functions": {
    "api/lyrics-sync.ts": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/)(?!.*\\.).*)", "destination": "/index.html" }
  ]
}
